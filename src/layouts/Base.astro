---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/figtree";
import "../styles/global.css";
import { SITE } from "../config";
import { SERVICE_PAGES, AREA_PAGES } from "../data/pages";
import Icon from "../components/Icon.astro";
import figtreeUrl from "@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url";
import bricolageUrl from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";

interface Props {
  title: string; description: string; path?: string; schema?: object[]; noindex?: boolean;
  image?: string; imageAlt?: string; article?: { published: string; modified: string };
}
const { title, description, path = "/", schema = [], noindex = false, image = "/og.jpg", imageAlt, article } = Astro.props;
const canonical = new URL(path, SITE.url).toString();
const telHref = SITE.phoneHref ? `tel:${SITE.phoneHref}` : "#help";
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={article ? "article" : "website"} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_AU" />
  <meta property="og:site_name" content={SITE.brand} />
  <meta property="og:image" content={new URL(image, SITE.url).toString()} />
  {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  {article && <meta property="article:published_time" content={article.published} />}
  {article && <meta property="article:modified_time" content={article.modified} />}
  <slot name="head" />
  <meta name="theme-color" content="#12304A" />
  <link rel="preload" href={figtreeUrl} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={bricolageUrl} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap site-header__inner">
      <a class="wordmark" href="/">
        <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="10" fill="#12304A"/><path d="M10 13h11.5a6 6 0 0 1 6 6v10" fill="none" stroke="#F26419" stroke-width="5" stroke-linecap="round"/><path d="M10 13h11.5a6 6 0 0 1 6 6v10" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span class="wordmark__text">Drain &amp; Pipe<span>Gold Coast</span></span>
      </a>
      <nav class="site-nav" aria-label="Main">
        <a href="/">Blocked drains</a>
        <a href="/pipe-relining-gold-coast">Pipe relining</a>
        <a href="/cctv-drain-inspection-gold-coast">CCTV</a>
        <a href="/emergency-plumber-gold-coast">Emergency</a>
        <a href="/#areas">Areas</a>
        <a href="/blog">Guides</a>
        <a href="/contact">Contact</a>
      </nav>
      <div class="header-call"><a class="btn btn--primary" href={telHref} data-track="call" aria-label={`Call ${SITE.phoneDisplay}`}><Icon name="phone" size={18} /><span class="btn__label">{SITE.phoneDisplay}</span></a></div>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span class="menu-btn__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </header>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile" hidden>
    <div class="wrap mobile-menu__inner">
      <ul class="mm-main">
        <li><a href="/">Blocked drains</a></li>
        <li><a href="/pipe-relining-gold-coast">Pipe relining</a></li>
        <li><a href="/cctv-drain-inspection-gold-coast">CCTV drain inspection</a></li>
        <li><a href="/emergency-plumber-gold-coast">Emergency plumber</a></li>
        <li><a href="/blog">Drain guides</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <p class="mm-head">More services</p>
      <ul class="mm-list">
        {SERVICE_PAGES.filter((p) => !["pipe-relining-gold-coast", "cctv-drain-inspection-gold-coast", "emergency-plumber-gold-coast"].includes(p.slug)).map((p) => <li><a href={`/${p.slug}`}>{p.name}</a></li>)}
      </ul>
      <p class="mm-head">Blocked drains by suburb</p>
      <ul class="mm-chips">
        {AREA_PAGES.map((p) => <li><a href={`/${p.slug}`}>{p.name}</a></li>)}
        <li><a href="/#areas">All suburbs</a></li>
      </ul>
      <a class="btn btn--primary btn--lg btn--block" href={telHref} data-track="call"><Icon name="phone" size={20} />Call {SITE.phoneDisplay}</a>
    </div>
  </nav>

  <main id="main"><slot /></main>

  <footer class="site-footer">
    <div class="wrap site-footer__grid">
      <div>
        <p class="footer-brand">{SITE.brand}</p>
        <p>Blocked drains, CCTV drain inspections and pipe relining across the City of Gold Coast.</p>
        <p class="footer-call"><a href={telHref} data-track="call">{SITE.phoneDisplay}</a></p>
      </div>
      <div>
        <p class="footer-head">Services</p>
        <ul class="footer-links">
          <li><a href="/">Blocked drains</a></li>
          {SERVICE_PAGES.map((p) => <li><a href={`/${p.slug}`}>{p.name}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="footer-head">Blocked drains by suburb</p>
        <ul class="footer-links">
          {AREA_PAGES.map((p) => <li><a href={`/${p.slug}`}>{p.name}</a></li>)}
          <li><a href="/#areas">All suburbs</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-head">Company</p>
        <ul class="footer-links">
          <li><a href="/about">About us</a></li>
          <li><a href="/blog">Drain guides</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privacy">Privacy policy</a></li>
          <li><a href="/terms">Terms of use</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap footer-base">
      <p>{SITE.brand} is a referral service operated by {SITE.operator}. We don't carry out plumbing work ourselves. We pass your enquiry to one independent, licensed Gold Coast plumber, who quotes and does the job directly with you.</p>
      <p>© {year} {SITE.brand}</p>
    </div>
  </footer>

  <div class="callbar" aria-label="Quick contact">
    <a class="btn btn--primary" href={telHref} data-track="call"><Icon name="phone" size={20} />Call {SITE.phoneDisplay}</a>
    <a class="btn btn--secondary" href="#help">Callback</a>
  </div>

  <script>
    // Lead form: validates, sends JSON to /api/lead, shows the result inline.
    const started = Date.now();
    const auPhone = /^(?:\+?61|0)[2-478](?:[ -]?\d){8}$/;
    const params = new URLSearchParams(location.search);
    const utm: Record<string, string> = {};
    ["utm_source", "utm_medium", "utm_campaign", "utm_term", "gclid"].forEach((k) => { const v = params.get(k); if (v) utm[k] = v; });

    document.querySelectorAll<HTMLFormElement>("[data-lead-form]").forEach((form) => {
      const status = form.querySelector<HTMLElement>(".lead-form__status")!;
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = String(data.get("name") || "").trim();
        const phone = String(data.get("phone") || "").replace(/[()\s]/g, "").trim();
        const suburb = String(data.get("suburb") || "").trim();
        let firstBad: HTMLElement | null = null;
        const mark = (field: string, ok: boolean) => {
          const el = form.querySelector<HTMLElement>(`[name=${field}]`)!;
          el.setAttribute("aria-invalid", ok ? "false" : "true");
          if (!ok && !firstBad) firstBad = el;
        };
        mark("name", name.length > 1);
        mark("phone", auPhone.test(phone));
        mark("suburb", suburb.length > 1);
        if (firstBad) {
          status.dataset.state = "error";
          status.textContent = !auPhone.test(phone) && name && suburb
            ? "Check the phone number. Use an Australian number, for example 0412 345 678."
            : "Fill in your name, phone number and suburb so the plumber can call you.";
          (firstBad as HTMLElement).focus();
          return;
        }
        button.disabled = true;
        button.textContent = "Sending…";
        const problem = String(data.get("problem") || "");
        const urgency = String(data.get("urgency") || "");
        const extra = String(data.get("message") || "").trim();
        const payload = {
          name, phone, suburb, problem, urgency,
          message: [urgency && `Urgency: ${urgency}`, problem && `Problem: ${problem}`, `Suburb: ${suburb}`, extra].filter(Boolean).join("\n"),
          email: "",
          page: location.pathname,
          utm,
          honeypot: String(data.get("company") || ""),
          elapsed_ms: Date.now() - started,
        };
        try {
          const res = await fetch("/api/lead", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(payload) });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          status.dataset.state = "ok";
          status.textContent = urgency === "now"
            ? "Sent. A local plumber will call you shortly. If sewage is overflowing, stop using water until they arrive."
            : "Sent. A local plumber will call you to arrange a time.";
          button.textContent = "Callback requested";
        } catch {
          status.dataset.state = "error";
          status.textContent = "Your request didn't send. Please call us instead, or try again in a minute.";
          button.disabled = false;
          button.textContent = "Request a callback";
        }
      });
    });

    // Mobile menu (burger): toggles the panel, locks page scroll, closes on Escape, link tap or resize to desktop.
    const menuBtn = document.querySelector<HTMLButtonElement>(".menu-btn");
    const menu = document.getElementById("mobile-menu");
    if (menuBtn && menu) {
      const setOpen = (open: boolean) => {
        menuBtn.setAttribute("aria-expanded", String(open));
        menuBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        menu.hidden = !open;
        document.documentElement.classList.toggle("menu-open", open);
      };
      menuBtn.addEventListener("click", () => setOpen(menuBtn.getAttribute("aria-expanded") !== "true"));
      menu.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) setOpen(false); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !menu.hidden) { setOpen(false); menuBtn.focus(); } });
      matchMedia("(min-width: 1100px)").addEventListener("change", (e) => { if (e.matches) setOpen(false); });
    }

    // Problem tiles pre-select the problem in the main form.
    document.querySelectorAll<HTMLAnchorElement>("[data-problem]").forEach((a) => {
      a.addEventListener("click", () => {
        const sel = document.querySelector<HTMLSelectElement>("#help select[name=problem]");
        if (sel) sel.value = a.dataset.problem || "";
      });
    });
  </script>
</body>
</html>
