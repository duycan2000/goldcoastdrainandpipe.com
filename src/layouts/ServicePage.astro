---
// Shared template for money, support and suburb pages. Content comes from src/data/pages.ts.
import Base from "./Base.astro";
import LeadForm from "../components/LeadForm.astro";
import PhoneSign from "../components/PhoneSign.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config";
import { PAGES } from "../data/pages";
import type { PageData } from "../data/types";
import { getPosts, postUrl } from "../lib/blog";

interface Props { page: PageData }
const { page } = Astro.props;
const path = `/${page.slug}`;
const related = page.related.map((s) => PAGES.find((p) => p.slug === s)).filter(Boolean) as PageData[];
const crumbParent = page.kind === "area" ? { name: "Areas", href: "/#areas" } : { name: "Services", href: "/#problems" };

const schema: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: page.h1,
    serviceType: page.serviceType ?? "Drain plumbing",
    areaServed: page.kind === "area"
      ? { "@type": "Place", name: `${page.name}, Gold Coast QLD` }
      : { "@type": "City", name: "Gold Coast", containedInPlace: { "@type": "State", name: "Queensland" } },
    provider: { "@type": "Organization", name: SITE.brand, url: SITE.url, ...(SITE.phoneHref ? { telephone: SITE.phoneHref } : {}) },
    url: new URL(path, SITE.url).toString(),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: page.name, item: new URL(path, SITE.url).toString() },
    ],
  },
];
if (page.faqs.length) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: page.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  });
}
const guides = (await getPosts()).filter((p) => p.data.money === page.slug);
const bandClass = (i: number) => (i % 2 === 0 ? "band" : "band band--tint");
---
<Base title={page.title} description={page.description} path={path} schema={schema}>
  <section class="phero">
    <div class="wrap phero__grid">
      <div class="phero__copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href={crumbParent.href}>{crumbParent.name}</a></li>
            <li aria-current="page">{page.name}</li>
          </ol>
        </nav>
        <h1>{page.h1}</h1>
        <p class="phero__lede">{page.lede}</p>
        <ul class="phero__points">
          {page.points.map((p) => <li><Icon name="check" size={20} />{p}</li>)}
        </ul>
        <PhoneSign note={false} />
        <p class="phero__note">Free call from any Australian phone. Price agreed before any work starts.</p>
      </div>
      <div class="phero__form">
        <LeadForm id="help" title="Get a plumber to call you" compact preselect={page.problem} suburb={page.kind === "area" ? page.name : ""} />
      </div>
    </div>
  </section>

  {page.blocks.map((b, i) => (
    <section class={bandClass(i)} id={b.id}>
      <div class="wrap">
        {b.kind === "prose" && (
          <div class:list={["prose-grid", { "prose-grid--aside": b.aside }]}>
            <div class="prose">
              <h2>{b.h2}</h2>
              {b.body.map((p) => <p set:html={p} />)}
            </div>
            {b.aside && (
              <aside class="aside">
                <h3>{b.aside.title}</h3>
                <ul>{b.aside.items.map((it) => <li set:html={it} />)}</ul>
              </aside>
            )}
          </div>
        )}

        {b.kind === "steps" && (
          <>
            <div class="head"><h2>{b.h2}</h2>{b.intro && <p>{b.intro}</p>}</div>
            <ol class="steps">{b.items.map((s) => <li><h3>{s.h}</h3><p set:html={s.p} /></li>)}</ol>
          </>
        )}

        {b.kind === "checklist" && (
          <div class:list={["check-wrap", { "check-wrap--warn": b.tone === "warn" }]}>
            <div class="head"><h2>{b.h2}</h2>{b.intro && <p>{b.intro}</p>}</div>
            <ul class:list={["checklist", { "checklist--warn": b.tone === "warn" }]}>{b.items.map((it) => <li set:html={it} />)}</ul>
            {b.tone === "warn" && <PhoneSign label="Urgent? Call now" />}
          </div>
        )}

        {b.kind === "facts" && (
          <>
            <div class="head"><h2>{b.h2}</h2>{b.intro && <p>{b.intro}</p>}</div>
            <dl class="facts">{b.items.map((f) => <div><dt>{f.term}</dt><dd set:html={f.text} /></div>)}</dl>
          </>
        )}

        {b.kind === "prices" && (
          <>
            <div class="head"><h2>{b.h2}</h2>{b.intro && <p>{b.intro}</p>}</div>
            <div class="price-card">
              <div class="table-wrap">
                <table>
                  <thead><tr><th scope="col">Job</th><th scope="col" class="num">Usual range</th><th scope="col" class="num">Typical</th></tr></thead>
                  <tbody>{b.rows.map((r) => <tr><th scope="row">{r.job}</th><td class="num">{r.range}</td><td class="num">{r.typical}</td></tr>)}</tbody>
                </table>
              </div>
              <p class="small price-note" set:html={b.note} />
            </div>
          </>
        )}

        {b.kind === "cards" && (
          <>
            <div class="head"><h2>{b.h2}</h2>{b.intro && <p>{b.intro}</p>}</div>
            <ul class="cards">
              {b.items.map((c) => (
                <li>
                  {c.href ? (
                    <a class="card card--link" href={c.href}>
                      <span class="icon-tile"><Icon name={c.icon} size={24} /></span>
                      <h3>{c.title}</h3>
                      <p>{c.text}</p>
                    </a>
                  ) : (
                    <div class="card">
                      <span class="icon-tile"><Icon name={c.icon} size={24} /></span>
                      <h3>{c.title}</h3>
                      <p>{c.text}</p>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </>
        )}

        {b.kind === "callout" && (
          <div class:list={["callout", { "callout--warn": b.tone === "warn" }]}>
            <h2>{b.title}</h2>
            {b.body.map((p) => <p set:html={p} />)}
          </div>
        )}
      </div>
    </section>
  ))}

  {page.faqs.length > 0 && (
    <section class={bandClass(page.blocks.length)} id="faq">
      <div class="wrap faq-wrap">
        <div class="head"><h2>{page.kind === "area" ? `Questions from ${page.name} homeowners` : "Common questions"}</h2></div>
        <div class="faq">
          {page.faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}<svg class="faq__chev" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
              <p set:html={f.a} />
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class={bandClass(page.blocks.length + 1)}>
      <div class="wrap">
        <div class="head"><h2>Related services</h2></div>
        <ul class="related">
          <li><a href="/"><span>Blocked drains Gold Coast</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></a></li>
          {related.map((r) => (
            <li><a href={`/${r.slug}`}><span>{r.linkText}</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></a></li>
          ))}
        </ul>
        {guides.length > 0 && (
          <>
            <h3 class="guides-title">Guides on this topic</h3>
            <ul class="related">
              {guides.map((g) => (
                <li><a href={postUrl(g)}><span>{g.data.h1}</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></a></li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
  )}

  {page.sources && (
    <div class="wrap sources"><p class="small">Sources: {page.sources.join(" · ")}</p></div>
  )}

  <section class="final">
    <div class="wrap final__grid">
      <div class="final__copy">
        <h2>Need a plumber for this today?</h2>
        <p>{page.cta ?? "Call and a licensed Gold Coast plumber takes it from there."} Or leave your number and they'll ring you.</p>
        <PhoneSign label="Call now" />
      </div>
      <LeadForm id="callback" title="Request a callback" preselect={page.problem} suburb={page.kind === "area" ? page.name : ""} />
    </div>
  </section>
</Base>

<style>
  .phero {
    color: #D6E1EB;
    background:
      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px) 0 0 / 28px 28px,
      radial-gradient(120% 90% at 0% 0%, #1D4366 0%, var(--navy-800) 55%, var(--navy-900) 100%);
    padding-block: var(--s-32) var(--s-48);
  }
  @media (min-width: 1000px) { .phero { padding-block: var(--s-48) var(--s-64); } }
  .phero__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-48); align-items: start; }
  @media (min-width: 1000px) { .phero__grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: var(--s-64); } }
  .phero__copy { display: grid; gap: var(--s-24); align-content: start; justify-items: start; }
  .phero__copy > * { max-width: 100%; }
  .phero h1 { color: #fff; font-size: clamp(2.25rem, 5vw, var(--fs-48)); max-width: 16ch; }
  .phero__lede { font-size: var(--fs-18); line-height: 1.6; max-width: 52ch; }
  .phero__points { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-8); font-size: var(--fs-16); }
  .phero__points li { display: flex; gap: var(--s-12); align-items: center; color: #fff; font-weight: 550; }
  .phero__points .icon { color: #5FD3C4; }
  .phero__note { font-size: var(--fs-14); color: #9FB4C7; margin-top: calc(var(--s-8) * -1); }
  .phero__form { min-width: 0; }

  .crumbs ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--s-8); font-size: var(--fs-14); color: #9FB4C7; }
  .crumbs li + li::before { content: "/"; margin-right: var(--s-8); color: #5E7A93; }
  .crumbs a { color: #D6E1EB; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs [aria-current] { color: #fff; }

  .band { padding-block: var(--s-64); background: #fff; }
  .band--tint { background: var(--sand-50); }
  @media (min-width: 900px) { .band { padding-block: var(--s-96); } }
  .head { display: grid; gap: var(--s-16); max-width: 680px; margin-bottom: var(--s-48); }
  .head p { color: var(--muted); }

  .prose-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-48); }
  @media (min-width: 1000px) { .prose-grid--aside { grid-template-columns: minmax(0, 1.4fr) minmax(0, .8fr); gap: var(--s-64); align-items: start; } }
  .prose { display: grid; gap: var(--s-16); max-width: 68ch; }
  .prose h2 { margin-bottom: var(--s-8); }
  .aside { background: var(--teal-50); border-radius: var(--r-lg); padding: var(--s-32); display: grid; gap: var(--s-16); }
  .aside ul { margin: 0; padding-left: var(--s-24); display: grid; gap: var(--s-8); font-size: var(--fs-16); }

  .steps { list-style: none; padding: 0; margin: 0; counter-reset: s; display: grid; gap: var(--s-32); max-width: 760px; }
  .steps li { counter-increment: s; position: relative; padding-left: var(--s-64); display: grid; gap: var(--s-4); }
  .steps li::before { content: counter(s); position: absolute; left: 0; top: -2px; width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; font: 700 var(--fs-18)/1 var(--font-display); }
  .steps li:not(:last-child)::after { content: ""; position: absolute; left: 19px; top: 46px; bottom: calc(var(--s-32) * -1 + 6px); width: 2px; background: var(--line); }
  .steps h3 { font-size: var(--fs-18); }
  .steps p { color: var(--muted); }

  .check-wrap { display: grid; gap: 0; }
  .check-wrap--warn { background: #FFF5EE; border: 1px solid #F8D6C2; border-top: 4px solid var(--orange); border-radius: var(--r-lg); padding: var(--s-32); gap: var(--s-24); }
  .check-wrap--warn .head { margin-bottom: 0; }
  .checklist { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-12) var(--s-48); }
  @media (min-width: 860px) { .checklist { grid-template-columns: 1fr 1fr; } }
  .checklist li { position: relative; padding-left: var(--s-32); font-size: var(--fs-16); line-height: 1.55; }
  .checklist li::before { content: ""; position: absolute; left: 4px; top: .5em; width: 10px; height: 10px; border-radius: 3px; background: var(--teal); }
  .checklist--warn li::before { content: "!"; left: 0; top: 1px; width: 22px; height: 22px; border-radius: 50%; background: var(--orange); color: var(--on-orange); font: 800 13px/22px var(--font-body); text-align: center; }

  .facts { margin: 0; display: grid; gap: var(--s-24) var(--s-48); }
  @media (min-width: 860px) { .facts { grid-template-columns: 1fr 1fr; } }
  .facts > div { display: grid; gap: var(--s-4); align-content: start; padding-top: var(--s-16); border-top: 2px solid var(--ink); }
  .facts dt { font-family: var(--font-display); font-weight: 650; font-size: var(--fs-20); color: var(--ink); letter-spacing: -.01em; }
  .facts dd { margin: 0; color: var(--muted); font-size: var(--fs-16); line-height: 1.6; }

  .price-card { background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--shadow-md); padding: var(--s-8) var(--s-24) var(--s-24); max-width: 820px; }
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { border-collapse: collapse; width: 100%; font-size: var(--fs-16); font-variant-numeric: tabular-nums; }
  th, td { text-align: left; vertical-align: top; padding: var(--s-16) var(--s-12); border-bottom: 1px solid var(--line); }
  thead th { font-size: var(--fs-14); font-weight: 600; color: var(--muted); }
  tbody th { font-weight: 600; color: var(--ink); }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  .num { text-align: right; }
  td.num { font-weight: 650; color: var(--ink); }
  td.num + td.num { font-weight: 500; color: var(--muted); }
  @media (min-width: 640px) { td.num { white-space: nowrap; } }
  @media (max-width: 560px) { th, td { padding: var(--s-12) var(--s-8); } }
  .price-note { border-top: 1px solid var(--line); padding-top: var(--s-16); }

  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-24); }
  @media (min-width: 760px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .cards { grid-template-columns: repeat(3, 1fr); } }
  .card { display: grid; gap: var(--s-12); align-content: start; height: 100%; padding: var(--s-32) var(--s-24); background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); color: var(--text); text-decoration: none; }
  .card p { color: var(--muted); font-size: var(--fs-16); line-height: 1.55; }
  .card--link { box-shadow: var(--shadow-sm); transition: border-color .15s, box-shadow .15s, transform .15s; }
  .card--link:hover { border-color: var(--line-strong); box-shadow: var(--shadow-md); transform: translateY(-1px); }
  .card--link h3 { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; transition: text-decoration-color .15s; }
  .card--link:hover h3 { text-decoration-color: currentColor; }

  .callout { max-width: 820px; display: grid; gap: var(--s-16); padding: var(--s-32); border-radius: var(--r-lg); background: var(--teal-50); border-left: 4px solid var(--teal); }
  .callout--warn { background: #FFF5EE; border-left-color: var(--orange); }
  .callout h2 { font-size: var(--fs-30); }

  .faq-wrap { max-width: 880px; }
  .faq { border-top: 1px solid var(--line); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: var(--s-24); padding: var(--s-24) 0; font-weight: 650; font-size: var(--fs-18); line-height: 1.4; color: var(--ink); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover { color: var(--teal-700); }
  .faq__chev { flex-shrink: 0; color: var(--teal); transition: transform .2s ease; }
  .faq details[open] .faq__chev { transform: rotate(180deg); }
  .faq details p { padding: 0 var(--s-48) var(--s-24) 0; max-width: 70ch; }

  .related { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-12); }
  @media (min-width: 760px) { .related { grid-template-columns: repeat(2, 1fr); gap: var(--s-16); } }
  .related a { display: flex; justify-content: space-between; align-items: center; gap: var(--s-16); padding: var(--s-16) var(--s-24); min-height: 64px; background: #fff; border: 1px solid var(--line); border-radius: var(--r-md); color: var(--ink); font-weight: 650; text-decoration: none; transition: border-color .15s, box-shadow .15s; }
  .related a:hover { border-color: var(--line-strong); box-shadow: var(--shadow-sm); }
  .related svg { color: var(--teal); flex-shrink: 0; }

  .sources { padding-block: var(--s-24); }
  .guides-title { font-size: var(--fs-20); margin: var(--s-48) 0 var(--s-16); }

  .final { background: var(--navy-800); color: #D6E1EB; padding-block: var(--s-64); }
  @media (min-width: 900px) { .final { padding-block: var(--s-96); } }
  .final__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-48); align-items: center; }
  @media (min-width: 1000px) { .final__grid { grid-template-columns: minmax(0, 1fr) minmax(0, .85fr); gap: var(--s-64); } }
  .final__copy { display: grid; gap: var(--s-24); justify-items: start; }
  .final__copy h2 { color: #fff; }
  .final__copy p { font-size: var(--fs-20); max-width: 40ch; }
</style>
