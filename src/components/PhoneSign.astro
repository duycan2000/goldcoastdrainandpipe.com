---
// Primary call button: the one place the page shouts.
import { SITE } from "../config";
import Icon from "./Icon.astro";
interface Props { label?: string; note?: boolean; block?: boolean }
const { label = "Call a local drain plumber", note = true, block = false } = Astro.props;
const href = SITE.phoneHref ? `tel:${SITE.phoneHref}` : "#help";
---
<div class:list={["call", { "call--block": block }]}>
  <a class="call__btn" href={href} data-track="call">
    <span class="call__icon"><Icon name="phone" size={24} /></span>
    <span class="call__text">
      <span class="call__label">{label}</span>
      <span class="call__number">{SITE.phoneDisplay}</span>
    </span>
  </a>
  {note && <p class="call__note">Free call from any Australian phone</p>}
</div>

<style>
  .call { display: inline-grid; gap: var(--s-8); }
  .call__btn {
    display: inline-flex; align-items: center; gap: var(--s-16);
    padding: var(--s-12) var(--s-24) var(--s-12) var(--s-12);
    background: var(--orange); color: var(--on-orange); text-decoration: none;
    border-radius: var(--r-md);
    box-shadow: 0 1px 0 rgba(255,255,255,.25) inset, 0 10px 24px -10px rgba(242,100,25,.65);
    transition: background-color .15s ease, transform .15s ease;
  }
  .call__btn:hover { background: var(--orange-hover); }
  .call__btn:active { transform: translateY(1px); }
  .call__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: rgba(26,18,6,.12); }
  .call__text { display: grid; gap: 2px; }
  .call__label { font-weight: 600; font-size: var(--fs-14); line-height: 1.2; }
  .call--block, .call--block .call__btn { display: flex; width: 100%; }
  .call--block { flex-direction: column; }
  .call--block .call__number { font-size: clamp(1.5rem, 2.4vw, 1.875rem); }
  @media (max-width: 999px) { .call, .call__btn { width: 100%; } }
  .call__number { white-space: nowrap; font-family: var(--font-display); font-weight: 750; font-size: clamp(1.75rem, 5vw, var(--fs-36)); line-height: 1; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .call__note { font-size: var(--fs-14); color: inherit; opacity: .75; margin: 0; padding-left: var(--s-4); }
</style>
